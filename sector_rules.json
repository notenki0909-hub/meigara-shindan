      "de":           { "dir": "lower_better", "good": 1.5, "warn": 2.5, "bad": 999 },
      "net_de":       { "dir": "lower_better", "good": 1.2, "warn": 2.2, "bad": 999 },
      "op_margin":    { "dir": "higher_better", "good": 3, "warn": 1.5, "bad": 0 }
    },
    "医薬品": {
