    },
    "空運業": {
      "payout_ni":    { "dir": "band", "good": [0, 35], "warn": [35, 60], "bad": [60, 999] },
      "streak_up":    { "dir": "higher_better", "good": 3, "warn": 1, "bad": 0 },
      "equity_ratio": { "dir": "higher_better", "good": 30, "warn": 15, "bad": 0 }
    },

    "銀行業": { "_simple": true },
    "保険業": { "_simple": true },
    "証券・商品先物取引業": { "_simple": true }
  }
}
