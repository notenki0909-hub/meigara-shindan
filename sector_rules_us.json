      "debt_to_ocf":  { "dir": "lower_better", "good": 8, "warn": 14, "bad": 999 },
      "interest_coverage": { "dir": "higher_better", "good": 3.0, "warn": 1.8, "bad": 0 },
      "chowder":      { "dir": "higher_better", "good": 8, "warn": 5, "bad": 0 },
